# Uploaded documents (Aadhar, PAN, profile photos) are sensitive — never
# serve them directly. They're only readable through the authenticated
# AccountController::document route, which checks the viewer is the owner
# or an admin before streaming the file.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Deny from all
</IfModule>
